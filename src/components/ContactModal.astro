---
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<dialog class="modal" id="contact-modal" aria-label="Contact Us">
  <div class="modal-box">
    <!-- Close button -->
    <button class="modal-close" id="modal-close" aria-label="Close">
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M4 4l12 12M16 4L4 16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- Success state -->
    <div class="modal-success" id="modal-success" hidden>
      <div class="modal-success__icon">
        <svg
          width="40"
          height="40"
          viewBox="0 0 40 40"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle cx="20" cy="20" r="20" fill="#22C55E"></circle>
          <path
            d="M11 20l6 6 12-12"
            stroke="white"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <h2 class="modal-success__title">Message sent!</h2>
      <p class="modal-success__body" id="modal-success-body">
        Thanks for reaching out — we'll get back to you soon.
      </p>
      <button class="modal-btn modal-btn--primary" id="modal-done">Done</button>
    </div>

    <!-- Form state -->
    <div id="modal-form-wrap">
      <h2 class="modal-title" id="modal-title">Contact Us</h2>
      <p class="modal-subtitle" id="modal-subtitle">
        Have a question? Want to learn more? Drop us a message.
      </p>

      <form class="modal-form" id="contact-form" novalidate>
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input
          type="hidden"
          name="subject"
          id="modal-subject"
          value="New Contact Message"
        />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none"
        />

        <div class="modal-field">
          <label class="modal-label" for="cm-name">Name</label>
          <input
            id="cm-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="modal-input"
            placeholder="Jane Smith"
          />
          <p class="modal-field-error" id="cm-name-error">
            Please enter your name.
          </p>
        </div>

        <div class="modal-field">
          <label class="modal-label" for="cm-email">Email</label>
          <input
            id="cm-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="modal-input"
            placeholder="jane@company.com"
          />
          <p class="modal-field-error" id="cm-email-error">
            Please enter a valid email address.
          </p>
        </div>

        <div class="modal-field">
          <label class="modal-label" for="cm-company">
            Company
            <span class="modal-label__optional">(optional)</span>
          </label>
          <input
            id="cm-company"
            name="company"
            type="text"
            autocomplete="organization"
            class="modal-input"
            placeholder="Acme Corp"
          />
        </div>

        <div class="modal-field">
          <label class="modal-label">Communication Preferences</label>
          <div class="modal-checkboxes">
            <label class="modal-checkbox">
              <input type="checkbox" name="newsletter" value="yes" />
              <span>Would you like to receive our newsletter?</span>
            </label>
            <label class="modal-checkbox">
              <input type="checkbox" name="updates" value="yes" />
              <span>Would you like to receive updates on our progress?</span>
            </label>
            <label class="modal-checkbox">
              <input type="checkbox" name="response" value="yes" />
              <span>Would you like a response to your message?</span>
            </label>
          </div>
        </div>

        <div class="modal-field">
          <label class="modal-label" for="cm-message">
            Message
            <span class="modal-label__optional">(optional)</span>
          </label>
          <textarea
            id="cm-message"
            name="message"
            rows="4"
            class="modal-input modal-textarea"
            placeholder="How can we help?"></textarea>
        </div>

        <p class="modal-error" id="modal-error" hidden></p>

        <div class="modal-actions">
          <button
            type="button"
            class="modal-btn modal-btn--ghost"
            id="modal-cancel">Cancel</button
          >
          <button
            type="submit"
            class="modal-btn modal-btn--primary"
            id="modal-submit">Send Message</button
          >
        </div>
      </form>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    const modal = document.getElementById("contact-modal");
    const formWrap = document.getElementById("modal-form-wrap");
    const successWrap = document.getElementById("modal-success");
    const form = document.getElementById("contact-form");
    const title = document.getElementById("modal-title");
    const subtitle = document.getElementById("modal-subtitle");
    const subject = document.getElementById("modal-subject");
    const successBody = document.getElementById("modal-success-body");
    const errorEl = document.getElementById("modal-error");
    const submitBtn = document.getElementById("modal-submit");
    const companyInput = document.getElementById("cm-company");
    const companyLabelOpt = companyInput?.previousElementSibling?.querySelector(
      ".modal-label__optional",
    );

    if (!modal || !form) return;

    // Store the element that opened the modal for focus restoration
    let triggerEl = null;
    let lastFocused = null;

    function open(mode) {
      lastFocused = document.activeElement;
      triggerEl = null;
      if (mode === "demo") {
        title.textContent = "Talk to us - we're listening";
        subtitle.textContent = "We want to know what challenges you're facing.";
        subject.value = "New Demo Request";
        if (companyLabelOpt) companyLabelOpt.style.display = "none";
        companyInput?.setAttribute("required", "required");
        successBody.textContent =
          "Thanks for sharing your safety management needs. We'll get back to you soon.";
      } else {
        title.textContent = "Contact Us";
        subtitle.textContent =
          "Have a question? Want to learn more? Drop us a message.";
        subject.value = "New Contact Message";
        if (companyLabelOpt) companyLabelOpt.style.display = "";
        companyInput?.removeAttribute("required");
        successBody.textContent =
          "Thanks for reaching out — we'll get back to you soon.";
      }
      resetForm();
      modal.showModal();
      document.body.style.overflow = "hidden";
    }

    function close() {
      modal.close();
      document.body.style.overflow = "";
      if (lastFocused) {
        try {
          lastFocused.focus();
        } catch (e) {
          /* ignore */
        }
      }
    }

    function resetForm() {
      form.reset();
      formWrap.hidden = false;
      successWrap.hidden = true;
      errorEl.hidden = true;
      errorEl.textContent = "";
      document.querySelectorAll(".modal-field-error").forEach((el) => {
        el.classList.remove("modal-field-error--visible");
      });
      submitBtn.textContent = "Send Message";
      submitBtn.disabled = false;
    }

    function validate() {
      let valid = true;
      const name = document.getElementById("cm-name");
      const email = document.getElementById("cm-email");
      const company = document.getElementById("cm-company");

      if (!name.value.trim()) {
        document
          .getElementById("cm-name-error")
          .classList.add("modal-field-error--visible");
        valid = false;
      } else {
        document
          .getElementById("cm-name-error")
          .classList.remove("modal-field-error--visible");
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email.value.trim())) {
        document
          .getElementById("cm-email-error")
          .classList.add("modal-field-error--visible");
        valid = false;
      } else {
        document
          .getElementById("cm-email-error")
          .classList.remove("modal-field-error--visible");
      }

      if (company.hasAttribute("required") && !company.value.trim()) {
        valid = false;
      }

      return valid;
    }

    // Open triggers
    document.querySelectorAll("[data-modal]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const mode = btn.getAttribute("data-modal");
        if (mode === "demo" || mode === "contact") {
          e.preventDefault();
          triggerEl = btn;
          open(mode);
        }
      });
    });

    // Close triggers
    document.getElementById("modal-close")?.addEventListener("click", close);
    document.getElementById("modal-cancel")?.addEventListener("click", close);
    document.getElementById("modal-done")?.addEventListener("click", close);

    // Backdrop click closes modal
    modal.addEventListener("click", (e) => {
      const rect = modal.getBoundingClientRect();
      if (
        e.clientX < rect.left ||
        e.clientX > rect.right ||
        e.clientY < rect.top ||
        e.clientY > rect.bottom
      ) {
        close();
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!validate()) return;

      submitBtn.textContent = "Sending…";
      submitBtn.disabled = true;
      errorEl.hidden = true;

      const data = new FormData(form);
      const json = {};
      data.forEach((value, key) => {
        if (key === "botcheck") return;
        if (json[key]) {
          if (Array.isArray(json[key])) {
            json[key].push(value);
          } else {
            json[key] = [json[key], value];
          }
        } else {
          json[key] = value;
        }
      });

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(json),
        });
        if (res.ok) {
          formWrap.hidden = true;
          successWrap.hidden = false;
          document.getElementById("modal-done")?.focus();
        } else {
          errorEl.textContent = "Something went wrong. Please try again.";
          errorEl.hidden = false;
          submitBtn.textContent = "Send Message";
          submitBtn.disabled = false;
        }
      } catch {
        errorEl.textContent = "Network error. Please try again.";
        errorEl.hidden = false;
        submitBtn.textContent = "Send Message";
        submitBtn.disabled = false;
      }
    });

    // Clear inline errors on input
    ["cm-name", "cm-email"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener("input", () => {
          document
            .getElementById(id + "-error")
            ?.classList.remove("modal-field-error--visible");
        });
      }
    });
  })();
</script>

<style>
  .modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.55);
    padding: 0;
    border: none;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .modal[open] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .modal::backdrop {
    background: rgba(0, 0, 0, 0.55);
  }

  .modal-box {
    position: relative;
    background: white;
    border-radius: 1rem;
    width: 100%;
    max-width: 480px;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    padding: 2rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.22);
    margin: 1rem;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #6b7280;
    cursor: pointer;
    border-radius: 0.5rem;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .modal-close:hover {
    background: #f3f4f6;
    color: #111827;
  }

  .modal-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.375rem;
  }

  .modal-subtitle {
    font-size: 0.9375rem;
    color: #6b7280;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modal-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .modal-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }

  .modal-label__optional {
    font-weight: 400;
    color: #9ca3af;
    margin-left: 0.25rem;
  }

  .modal-input {
    padding: 0.625rem 0.875rem;
    border: 1.5px solid #e5e7eb;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    color: #111827;
    background: #fff;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
    width: 100%;
  }

  .modal-input:focus {
    outline: none;
    border-color: #00aeef;
    box-shadow: 0 0 0 3px rgba(0, 174, 239, 0.15);
  }

  .modal-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .modal-checkboxes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .modal-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #374151;
    cursor: pointer;
  }

  .modal-checkbox input {
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .modal-error {
    color: #ef4444;
    font-size: 0.875rem;
    margin: 0;
  }

  .modal-field-error {
    color: #ef4444;
    font-size: 0.8rem;
    margin: 0;
    display: none;
  }

  .modal-field-error--visible {
    display: block;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .modal-btn {
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s,
      transform 0.15s;
    border: none;
  }

  .modal-btn--ghost {
    background: transparent;
    color: #6b7280;
  }

  .modal-btn--ghost:hover {
    background: #f3f4f6;
    color: #374151;
  }

  .modal-btn--primary {
    background: #111827;
    color: white;
  }

  .modal-btn--primary:hover {
    background: #1f2937;
    transform: translateY(-1px);
  }

  .modal-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Success state */
  .modal-success {
    text-align: center;
    padding: 1rem 0;
  }

  .modal-success__icon {
    margin-bottom: 1rem;
  }

  .modal-success__title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.5rem;
  }

  .modal-success__body {
    font-size: 0.9375rem;
    color: #6b7280;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }
</style>
