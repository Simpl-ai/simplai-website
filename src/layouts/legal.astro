---
import Layout from "./layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../sections/footer.astro";
import ContactModal from "../components/ContactModal.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <Navbar />
  <main id="main-content" class="legal-page">
    <div class="legal-page__container">
      <slot />
    </div>
  </main>
  <Footer />
  <ContactModal />
</Layout>

<style>
  .legal-page {
    min-height: calc(100vh - 72px);
    background: var(--color-bg-card);
    padding: 4rem 0 6rem;
  }

  .legal-page__container {
    max-width: 860px;
    margin: 0 auto;
    background: var(--color-bg-white);
    border-radius: 1rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    padding: 3rem 3.5rem;
  }

  @media (max-width: 640px) {
    .legal-page__container {
      padding: 2rem 1.25rem;
    }
  }
</style>

<style is:global>
  .legal-page__container h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-brand-dark);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .legal-page__container h2 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-dark);
    margin: 2.25rem 0 0.75rem;
  }

  .legal-page__container h2:first-of-type {
    margin-top: 1.75rem;
  }

  .legal-page__container p {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.75;
    margin: 0 0 1rem;
  }

  .legal-page__container ul {
    margin: 0 0 1rem 1.25rem;
    padding: 0;
  }

  .legal-page__container li {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.75;
    margin-bottom: 0.25rem;
  }

  .legal-page__container a {
    color: var(--color-brand-blue);
    text-decoration: none;
  }

  .legal-page__container a:hover {
    text-decoration: underline;
  }

  .legal-page__container hr {
    border: none;
    border-top: 1px solid var(--color-border-default);
    margin: 1.75rem 0;
  }

  .legal-page__container strong {
    color: var(--color-brand-dark);
    font-weight: 600;
  }

  .legal-page__container em {
    font-style: italic;
  }

  .legal-page__container table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 1rem 0 1.5rem;
  }

  .legal-page__container th {
    text-align: left;
    font-weight: 600;
    color: var(--color-brand-dark);
    padding: 0.625rem 0.875rem;
    background: var(--color-bg-white);
    border-bottom: 2px solid var(--color-border-default);
  }

  .legal-page__container td {
    padding: 0.625rem 0.875rem;
    color: var(--color-text-body);
    border-bottom: 1px solid var(--color-border-default);
  }
</style>
